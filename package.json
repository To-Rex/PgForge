{
  "name": "pgforge",
  "private": true,
  "version": "1.0.0",
  "description": "PgForge — PostgreSQL management platform",
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev:server": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace web",
    "build": "npm run build --workspace server && npm run build --workspace web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace server",
    "start": "NODE_ENV=production node server/dist/index.js"
  }
}
