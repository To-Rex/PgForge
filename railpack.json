{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "packages": {
    "node": "22"
  },
  "buildAptPackages": [
    "ca-certificates",
    "curl"
  ],
  "steps": {
    "build": {
      "commands": [
        "npm install",
        "npm run build"
      ]
    },
    "pg-client": {
      "inputs": [
        {
          "local": true,
          "include": [
            "deploy"
          ]
        }
      ],
      "commands": [
        "sh ./deploy/install-pg-client.sh"
      ],
      "deployOutputs": [
        {
          "include": [
            "/usr/lib/postgresql/18",
            "/usr/share/postgresql/18"
          ]
        }
      ]
    }
  },
  "deploy": {
    "aptPackages": [
      "libreadline8t64",
      "libgssapi-krb5-2",
      "libldap2",
      "libsasl2-2",
      "libssl3t64",
      "zlib1g",
      "liblz4-1",
      "libzstd1"
    ],
    "startCommand": "npm start",
    "variables": {
      "PG_DUMP_PATH": "/usr/lib/postgresql/18/bin/pg_dump",
      "PG_RESTORE_PATH": "/usr/lib/postgresql/18/bin/pg_restore",
      "PSQL_PATH": "/usr/lib/postgresql/18/bin/psql",
      "LD_LIBRARY_PATH": "/usr/lib/postgresql/18/lib"
    }
  }
}
