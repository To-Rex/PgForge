# ── PgForge server configuration ─────────────────────────────────────────────

# Master secret (min 32 chars) from which the JWT signing key and the
# credential-encryption key are derived via HKDF.
# Generate one:  openssl rand -base64 48
# If unset, a secret is generated once and persisted to DATA_DIR/secret.key —
# keep that file (or set APP_SECRET) or stored connection passwords become
# unreadable and must be re-entered.
APP_SECRET=

# HTTP
PORT=7070
HOST=0.0.0.0

# Directory for the metadata store (SQLite) and backup artifacts.
DATA_DIR=./data

# Where PgForge keeps its OWN data (users, connections, saved queries, history,
# audit). Unset = the SQLite file under DATA_DIR only, which is lost whenever a
# deploy replaces the container filesystem.
#
# Set it to a PostgreSQL database dedicated to PgForge — hosted OUTSIDE this
# container, and not one of the servers you manage from the app — and that
# SQLite image is mirrored there: restored on boot, uploaded after every write.
# Backup FILES are not included; they stay in DATA_DIR and still need a volume.
#
# The Settings -> Application database panel can test a DSN and write this line
# for you. In an image-based deploy, put it in the platform's environment
# editor instead: a .env inside the container does not survive the next build.
# METADATA_URL=postgresql://pgforge:password@db.example.com:5432/pgforge?sslmode=require

# Comma-separated origins allowed by CORS (only needed when the web app is
# served from a different origin than the API, e.g. during development).
CORS_ORIGINS=http://localhost:5173

# Public base URL used inside emailed links (invitations). When unset, it is
# derived from the incoming request (works behind Dokploy/reverse proxies).
# PUBLIC_URL=https://pgforge.example.com

# Default statement timeout for user-issued SQL (ms). Requests may lower it,
# never exceed SQL_MAX_TIMEOUT_MS.
SQL_DEFAULT_TIMEOUT_MS=30000
SQL_MAX_TIMEOUT_MS=600000

# Hard cap on rows returned per statement to the browser.
SQL_MAX_ROWS=5000

# Hung pg_dump/pg_restore processes are killed after this long (default 2h).
BACKUP_TIMEOUT_MS=7200000

# Override paths to PostgreSQL client tools if they are not on PATH.
# PG_DUMP_PATH=/usr/lib/postgresql/18/bin/pg_dump
# PG_RESTORE_PATH=/usr/lib/postgresql/18/bin/pg_restore
# PSQL_PATH=/usr/lib/postgresql/18/bin/psql

# Default SMTP for backup delivery. Used (and shown pre-filled, enabled) until
# delivery settings are saved in the UI — after that the UI values win.
# Keep real credentials only here (.env is gitignored), never in code.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls        # ssl | starttls | none
# SMTP_USER=you@example.com
# SMTP_PASSWORD="app password"
# SMTP_FROM=you@example.com
# SMTP_TO=recipient@example.com
